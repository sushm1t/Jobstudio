# AI Configuration (Primary: Local Ollama with Gemma 4 — Zero API Costs)
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma4:latest"
DISABLE_EXTERNAL_APIS="true"

# (Optional) Cloud Fallback - Only used if DISABLE_EXTERNAL_APIS="false" and AI_PROVIDER="gemini"
# GEMINI_API_KEY="your-gemini-api-key"

APP_URL="http://localhost:8080"
PORT=8080

# Supabase Cloud Configuration (Authentication and Data Sync - Optional)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
